    "NEXT_PUBLIC_CONTRACT_INTENT_FACTORY_ADDRESS": "0x4ee570d86719d19d07fa2eaaad3c74e52229edf3",
    "NEXT_PUBLIC_CONTRACT_INTENT_EXECUTOR_ADDRESS": "0xe48fa354202ce0818cb794f01708ef9818ee0c23",
    "NEXT_PUBLIC_WRAPPED_ETH_TOKEN_ADDRESS": "0x4200000000000000000000000000000000000006",
    "NEXT_PUBLIC_LINK_TOKEN_ADDRESS": "0xE4aB69C077896252FAFBD49EFD26B5D171A32410",
    "NEXT_PUBLIC_PRICE_FEED_CONTRACT_LINK_TO_ETH_ADDRESS": "0x56a43EB56Da12C0dc1D972ACb089c06a5dEF8e69",
