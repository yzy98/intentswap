{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-27",
  "minify": true,
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INTENTS_SUBSCRIPTIONS",
      "id": "ce71ef4f56e948e5b9894943d0f8bb8b",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
  // "compatibility_flags": ["nodejs_compat"],
