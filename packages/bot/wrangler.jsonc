{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-27",
  "minify": true,
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INTENTS_SUBSCRIPTIONS",
      "id": "ce71ef4f56e948e5b9894943d0f8bb8b",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "CORS_ORIGIN": "http://localhost:3000",
    "CHAIN_ID": "11155111",
    "RPC_URL": "https://sepolia.infura.io/v3/36ab41cc918b4d198e7d6f59730f4e52",
    "CONTRACT_ORACLE_ADDRESS": "0x6996467301d930c845df4711bd5c73021e13c6ca",
    "CONTRACT_SWAPPER_ADDRESS": "0xb7ffe6beddb3e1e2998acc358aaf2b0ce69c6c0e",
    "CONTRACT_INTENT_FACTORY_ADDRESS": "0xeeb1ea6e4828b24c76a117dafeb31b1c6424da15",
    "CONTRACT_INTENT_EXECUTOR_ADDRESS": "0xe6e00e7a50f2ee0d444066001051181fc1d7bd0d"
  }
  // "compatibility_flags": ["nodejs_compat"],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
