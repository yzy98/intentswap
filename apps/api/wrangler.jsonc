{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "INTENT_SWAP_API_HYPERDRIVE",
      "id": "e809e11046144cb786f6c8c63dfeceb9"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://intentswap.zyang.space",
    "API_BASE_URL": "",
    "ENVIRONMENT": "production",
    "CHAIN_ID": "84532"
  }
}
