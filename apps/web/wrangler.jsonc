{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intentswap",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_PROJECT_ID": "a9d2a807b7a809074b13b7677bee5fe1",
    "NEXT_PUBLIC_CHAIN_ID": "84532",
    "NEXT_PUBLIC_WRAPPED_ETH_TOKEN_ADDRESS": "0x4200000000000000000000000000000000000006",
    "NEXT_PUBLIC_LINK_TOKEN_ADDRESS": "0xE4aB69C077896252FAFBD49EFD26B5D171A32410",
    "NEXT_PUBLIC_PRICE_FEED_CONTRACT_LINK_TO_ETH_ADDRESS": "0x56a43EB56Da12C0dc1D972ACb089c06a5dEF8e69",
    "NEXT_PUBLIC_BOT_API_URL": "https://intentswap.bot.zyang.space",
    "NEXT_PUBLIC_API_BASE_URL": "https://intentswap.api.zyang.space"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
