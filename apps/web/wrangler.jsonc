{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intentswap",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_PROJECT_ID": "a9d2a807b7a809074b13b7677bee5fe1",
    "NEXT_PUBLIC_CHAIN_ID": "11155111",
    "NEXT_PUBLIC_WRAPPED_ETH_TOKEN_ADDRESS": "0xfff9976782d46cc05630d1f6ebab18b2324d6b14",
    "NEXT_PUBLIC_LINK_TOKEN_ADDRESS": "0x779877A7B0D9E8603169DdbD7836e478b4624789",
    "NEXT_PUBLIC_PRICE_FEED_CONTRACT_LINK_TO_ETH_ADDRESS": "0x42585eD362B3f1BCa95c640FdFf35Ef899212734",
    "NEXT_PUBLIC_BOT_API_URL": "https://intentswap.bot.zyang.space",
    "NEXT_PUBLIC_API_BASE_URL": "https://intentswap.api.zyang.space"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
